# ==============================================================================
# AI Health Information Assistant - Environment Configuration
# ==============================================================================
# Default port for Express backend
PORT=5000

# Active LLM Provider: 'mock' (default offline), 'watsonx', 'gemini', or 'openai'
# If LLM_API_KEY is unset, the system automatically runs the extractive RAG mock
# so the application works out-of-the-box without requiring any API keys.
LLM_PROVIDER=mock
LLM_API_KEY=

# ------------------------------------------------------------------------------
# Option 1: IBM watsonx.ai Foundation Models Configuration
# ------------------------------------------------------------------------------
# IBM Cloud API Key (or set LLM_API_KEY)
WATSONX_APIKEY=
# Your IBM Cloud watsonx Project ID
WATSONX_PROJECT_ID=
# Regional URL (e.g. Dallas: https://us-south.ml.cloud.ibm.com)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Foundation Model ID (e.g. ibm/granite-3-8b-instruct or ibm/granite-13b-chat-v2)
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ------------------------------------------------------------------------------
# Option 2: Google Gemini Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Option 3: OpenAI Configuration
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
